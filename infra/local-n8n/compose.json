{
  "name": "dpd-n8n-local",
  "services": {
    "n8n": {
      "image": "${DPD_N8N_IMAGE:?Use the guarded Step649 launcher}",
      "container_name": "dpd-n8n-local",
      "restart": "unless-stopped",
      "ports": [
        "127.0.0.1:5678:5678"
      ],
      "environment": {
        "TZ": "Asia/Dubai",
        "GENERIC_TIMEZONE": "Asia/Dubai",
        "N8N_HOST": "localhost",
        "N8N_PORT": "5678",
        "N8N_PROTOCOL": "http",
        "N8N_EDITOR_BASE_URL": "http://localhost:5678",
        "WEBHOOK_URL": "http://localhost:5678/",
        "N8N_SECURE_COOKIE": "true",
        "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS": "true",
        "N8N_BLOCK_ENV_ACCESS_IN_NODE": "true",
        "N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES": "true",
        "N8N_COMMUNITY_PACKAGES_ENABLED": "false",
        "N8N_DIAGNOSTICS_ENABLED": "false",
        "N8N_VERSION_NOTIFICATIONS_ENABLED": "false",
        "N8N_TEMPLATES_ENABLED": "false",
        "EXECUTIONS_DATA_SAVE_ON_SUCCESS": "none",
        "EXECUTIONS_DATA_SAVE_ON_ERROR": "none",
        "EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS": "false",
        "EXECUTIONS_DATA_PRUNE": "true",
        "EXECUTIONS_DATA_MAX_AGE": "168",
        "EXECUTIONS_TIMEOUT": "120",
        "EXECUTIONS_TIMEOUT_MAX": "300"
      },
      "volumes": [
        "n8n_data:/home/node/.n8n"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "labels": {
        "com.dpd.local-n8n.root": "${DPD_N8N_ROOT:?Use the guarded launcher}",
        "com.dpd.local-n8n.config": "${DPD_N8N_CONFIG:?Use the guarded launcher}"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "1g",
      "cpus": 1.0,
      "pids_limit": 256
    }
  },
  "volumes": {
    "n8n_data": {
      "name": "dpd-n8n-local-data",
      "labels": {
        "com.dpd.local-n8n.root": "${DPD_N8N_ROOT:?Use the guarded launcher}"
      }
    }
  }
}
