# Copy to .env for local development. NEVER commit .env.
# All values below are local-development placeholders, not real credentials.

# --- application ---------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=true
DEFAULT_TENANT_ID=demo-org
APP_VERSION=0.1.0

# --- API -------------------------------------------------------------------
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENABLE_DEV_ROUTES=true             # must be false outside development/test
RATE_LIMIT_PER_MINUTE=120

# --- security ----------------------------------------------------------------
AUTH_MODE=dev                      # dev (local only) | token (requires a TokenVerifier)
SECRET_KEY=change-me-local-development-only
# WEBHOOK_SIGNING_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300
PII_REDACTION_ENABLED=true

# --- persistence -------------------------------------------------------------
# Local Docker defaults. Use a secret manager for any shared environment.
POSTGRES_USER=dubai_ai
POSTGRES_PASSWORD=dubai_ai_local
POSTGRES_DB=dubai_ai
DATABASE_URL=postgresql+asyncpg://dubai_ai:dubai_ai_local@localhost:5432/dubai_ai
REDIS_URL=redis://localhost:6379/0
READINESS_CHECKS_REQUIRED=false
READINESS_PROBE_TIMEOUT_SECONDS=3

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=mock                  # only "mock" has an adapter today
LLM_PRIMARY_MODEL=mock-deterministic
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# LLM_API_KEY=

# --- knowledge / RAG ---------------------------------------------------------
EMBEDDING_PROVIDER=hashing         # offline lexical embedder for development
EMBEDDING_DIMENSION=1536           # must match the database migration
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120

# --- agents & governance -----------------------------------------------------
AGENT_DEFAULT_TIMEOUT_SECONDS=20
APPROVAL_REQUIRED_FOR_OUTBOUND_MESSAGES=true
APPROVAL_REQUIRED_FOR_CRM_WRITES=false
APPROVAL_REQUIRED_FOR_CALENDAR_EVENTS=true
DATA_RETENTION_DAYS_CONVERSATIONS=365
DATA_RETENTION_DAYS_AUDIT_LOGS=2555

# --- integrations (mock unless INTEGRATIONS_MODE=live AND credentials set) ---
INTEGRATIONS_MODE=mock
# ESPOCRM_BASE_URL=
# ESPOCRM_API_KEY=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_ACCESS_TOKEN=
# META_APP_SECRET=
META_GRAPH_API_VERSION=v20.0
# GOOGLE_CREDENTIALS_FILE=
# TELEPHONY_PROVIDER=
# N8N_WEBHOOK_BASE_URL=
# SLACK_WEBHOOK_URL=

# --- dashboard ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
